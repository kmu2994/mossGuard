# Moss credentials — sign up at https://moss.dev
MOSS_PROJECT_ID=your_moss_project_id
MOSS_PROJECT_KEY=your_moss_project_key
MOSS_INDEX_NAME=mossguard-kb

# Gemini API credentials via https://llm.hidevs.xyz/v1
GEMINI_KEY=
LLM_BASE_URL=https://llm.hidevs.xyz/v1

# LLM model to use (gpt-4o-mini recommended for speed)
LLM_MODEL=gemini-3.5-flash-lite
